return ""
endif
let s:nextrel += 1
elseif ind != 0
return s:CheckBlockTag(a:itag, ind)
endif
return ""
endfunc "}}}
func! s:CheckBlockTag(blocktag, ind)
if a:ind > 0
if s:block != 0
return ""
endif
let s:block = a:ind		" block type
if s:countonly
return ""
endif
let b:hi_newstate.blocklnr = v:lnum
