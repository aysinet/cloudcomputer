\       . s:delimitMate_extra_excluded_regions
\|endif
autocmd User <buffer>
\ if expand('<afile>') ==# 'delimitMate_unmap'
\|  let b:delimitMate_excluded_regions = substitute(
\       delimitMate#Get("excluded_regions"),
