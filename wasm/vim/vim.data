syn match CfgSection	    "{.*}"
syn match  CfgString	"\".*\"" contained
syn match  CfgString    "'.*'"   contained
syn match  CfgComment	"#.*"
syn match  CfgComment	";.*"
syn match  CfgComment	"\/\/.*"
