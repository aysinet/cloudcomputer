endfunc "}}}
func! HtmlIndent_FindTagEnd()
let text = getline('.')
let tagname = matchstr(text, s:tagname . '\|!--', col('.'))
if tagname == '!--'
call search('--\zs>')
elseif s:get_tag('/' . tagname) != 0
