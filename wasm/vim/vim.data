\ nextgroup=slpconfTag,
\ slpconfComment skipwhite
syn keyword slpconfTag          contained net
\ nextgroup=slpconfNetTagDot
syn match   slpconfNetTagDot    contained display '.'
\ nextgroup=slpconfNetTag
