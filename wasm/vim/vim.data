let b:did_scheme_syntax = 1
if exists('b:is_chicken') || exists('g:is_chicken')
exe 'ru! syntax/chicken.vim'
endif
unlet b:did_scheme_syntax
let b:current_syntax = 'scheme'
let &cpo = s:cpo
unlet s:cpo
if exists("b:current_syntax")
finish
endif
