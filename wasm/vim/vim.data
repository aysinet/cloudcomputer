function! s:PrevMatch(lnum, regex)
let prev_lnum = prevnonblank(a:lnum - 1)
while prev_lnum > 0
let prev_line = getline(prev_lnum)
if prev_line =~? a:regex
break
else
let prev_lnum = prevnonblank(prev_lnum - 1)
endif
endwhile
