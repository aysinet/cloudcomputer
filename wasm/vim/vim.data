\ ['Re'		, 'ℜ'],
\ ['quad'		, ' '],
\ ['qquad'		, ' '],
\ ['rfloor'		, '⌋'],
\ ['right)'		, ')'],
\ ['right]'		, ']'],
\ ['right\\}'	, '}'],
\ ['rightarrow'	, '→'],
\ ['Rightarrow'	, '⇒'],
\ ['rightleftharpoons', '⇌'],
\ ['rmoustache'     , '╮'],
\ ['S'	        , '§'],
\ ['searrow'	, '↘'],
\ ['setminus'	, '∖'],
\ ['sharp'		, '♯'],
\ ['sim'		, '∼'],
\ ['simeq'		, '⋍'],
\ ['smile'		, '‿'],
\ ['spadesuit'	, '♠'],
\ ['sqcap'		, '⊓'],
\ ['sqcup'		, '⊔'],
\ ['sqsubset'	, '⊏'],
\ ['sqsubseteq'	, '⊑'],
\ ['sqsupset'	, '⊐'],
\ ['sqsupseteq'	, '⊒'],
\ ['star'		, '✫'],
\ ['subset'		, '⊂'],
\ ['subseteq'	, '⊆'],
\ ['succ'		, '≻'],
\ ['succeq'		, '⪰'],
\ ['sum'		, '∑'],
\ ['supset'		, '⊃'],
\ ['supseteq'	, '⊇'],
\ ['surd'		, '√'],
\ ['swarrow'	, '↙'],
\ ['times'		, '×'],
\ ['to'		, '→'],
\ ['top'		, '⊤'],
