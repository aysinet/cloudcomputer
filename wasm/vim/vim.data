\ contained
\ contains=valgrindOptions,valgrindMsg,valgrindLoc
syn match valgrindOptions "[ ]\{3}-.*$" contained
syn match valgrindMsg "\S.*$" contained
\ contains=valgrindError,valgrindNote,valgrindSummary
