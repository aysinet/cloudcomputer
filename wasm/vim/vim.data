au BufNewFile,BufRead */.cmus/{autosave,rc,command-history,*.theme} setf cmusrc
au BufNewFile,BufRead */cmus/{rc,*.theme}			setf cmusrc
au BufNewFile,BufRead *.cbl,*.cob,*.lib	setf cobol
au BufNewFile,BufRead *.cpy
\ if getline(1) =~ '^##' |
\   setf python |
\ else |
\   setf cobol |
\ endif
