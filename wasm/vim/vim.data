function! GetGitconfigIndent()
let sw    = shiftwidth()
let line  = getline(prevnonblank(v:lnum-1))
let cline = getline(v:lnum)
if line =~  '\\\@<!\%(\\\\\)*\\$'
return 2 * sw
elseif cline =~ '^\s*\['
return 0
elseif cline =~ '^\s*\a'
return sw
elseif cline == ''       && line =~ '^\['
return sw
else
return -1
endif
endfunction
