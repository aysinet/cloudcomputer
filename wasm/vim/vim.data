let ind = ind + shiftwidth()
endif
if line =~ '\v^\s*breaksw>'
let ind = ind - shiftwidth()
endif
let line = getline(v:lnum)
if line =~ '\v^\s*%(else|end|endif)\s*$'
let ind = ind - shiftwidth()
endif
return ind
endfunction
