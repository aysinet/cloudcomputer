norm! $?\a
let fname   = b:netrw_curdir.'/'.s:NetrwGetWord()
let resname = resolve(fname)
if resname =~ '^\M'.b:netrw_curdir.'/'
let dirlen  = strlen(b:netrw_curdir)
let resname = strpart(resname,dirlen+1)
