if !exists('*<SID>Python_jump')
fun! <SID>Python_jump(mode, motion, flags, count, ...) range
let l:startofline = (a:0 >= 1) ? a:1 : 1
if a:mode == 'x'
normal! gv
endif
if l:startofline == 1
normal! 0
endif
let cnt = a:count
mark '
while cnt > 0
call search(a:motion, a:flags)
let cnt = cnt - 1
endwhile
if l:startofline == 1
normal! ^
endif
endfun
endif
