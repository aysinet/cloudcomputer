function! <SID>Abaqus_ToggleComment() range
if strpart(getline(a:firstline), 0, 2) == "**"
silent execute a:firstline . ',' . a:lastline . 's/^\*\*//'
else
silent execute a:firstline . ',' . a:lastline . 's/^/**/'
endif
endfunction
