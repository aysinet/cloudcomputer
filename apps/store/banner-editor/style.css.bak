/* ── Banner Editor ── */
.be-root {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #1e1e2e;
  color: #e0e0e0;
  overflow: hidden;
  user-select: none;
  font-family: 'Segoe UI', sans-serif;
  font-size: 13px;
}

/* ── Toolbar ── */
.be-toolbar {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 5px 10px;
  background: #181825;
  border-bottom: 1px solid rgba(255,255,255,.08);
  flex-shrink: 0;
  flex-wrap: wrap;
}
.be-tb-group {
  display: flex;
  align-items: center;
  gap: 4px;
}
.be-tb-sep {
  width: 1px;
  height: 22px;
  background: rgba(255,255,255,.1);
  margin: 0 4px;
}
.be-tb-label {
  font-size: 11px;
  color: #888;
  white-space: nowrap;
}
.be-tb-btn {
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.1);
  color: #ccc;
  padding: 4px 8px;
  border-radius: 5px;
  cursor: pointer;
  font-size: 13px;
  transition: background .15s;
  white-space: nowrap;
}
.be-tb-btn:hover { background: rgba(255,255,255,.12); color: #fff; }
.be-tb-btn:disabled { opacity: .35; cursor: not-allowed; }
.be-tb-btn.active { background: rgba(74,144,217,.3); border-color: #4a90d9; color: #fff; }
.be-tb-accent {
  background: rgba(74,144,217,.15);
  border-color: rgba(74,144,217,.3);
  color: #6aabf7;
}
.be-tb-accent:hover { background: rgba(74,144,217,.3); color: #fff; }

/* ── Inputs ── */
.be-select {
  background: #2a2a3e;
  color: #c5cde8;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 5px;
  padding: 4px 6px;
  font-size: 12px;
  outline: none;
  cursor: pointer;
}
.be-input {
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 5px;
  padding: 4px 8px;
  color: #e1e4ea;
  font-size: 12px;
  outline: none;
  width: 64px;
}
.be-input:focus { border-color: rgba(74,144,217,.5); }
.be-input-sm { width: 56px; }
.be-input-xs { width: 44px; }
.be-color-input {
  width: 28px;
  height: 24px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 4px;
  background: none;
  cursor: pointer;
  padding: 0;
}
.be-range {
  width: 80px;
  accent-color: #4a90d9;
}
.be-textarea {
  width: 100%;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 6px;
  padding: 6px 8px;
  color: #e1e4ea;
  font-size: 12px;
  resize: vertical;
  outline: none;
  font-family: inherit;
  box-sizing: border-box;
}
.be-textarea:focus { border-color: rgba(74,144,217,.5); }

/* ── Main layout ── */
.be-main {
  flex: 1;
  display: flex;
  overflow: hidden;
  min-height: 0;
}

/* ── Layers Panel ── */
.be-layers-panel {
  width: 180px;
  background: #181825;
  border-right: 1px solid rgba(255,255,255,.08);
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}
.be-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 10px;
  font-size: 12px;
  font-weight: 600;
  color: #aab0c6;
  border-bottom: 1px solid rgba(255,255,255,.06);
  text-transform: uppercase;
  letter-spacing: .03em;
}
.be-panel-actions {
  display: flex;
  gap: 2px;
}
.be-sm-btn {
  background: none;
  border: none;
  color: #888;
  cursor: pointer;
  font-size: 11px;
  padding: 2px 4px;
  border-radius: 3px;
}
.be-sm-btn:hover { background: rgba(255,255,255,.1); color: #fff; }
.be-sm-btn-danger:hover { color: #f56c6c; }
.be-layers-list {
  flex: 1;
  overflow-y: auto;
  padding: 4px;
}
.be-layer-item {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 8px;
  border-radius: 6px;
  cursor: pointer;
  transition: background .12s;
  font-size: 12px;
}
.be-layer-item:hover { background: rgba(255,255,255,.05); }
.be-layer-item.active { background: rgba(74,144,217,.2); color: #fff; }
.be-layer-icon { font-size: 14px; flex-shrink: 0; }
.be-layer-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}
.be-layer-vis {
  background: none;
  border: none;
  color: #888;
  font-size: 12px;
  cursor: pointer;
  padding: 0 2px;
}
.be-layers-empty {
  text-align: center;
  color: #5a5e72;
  padding: 20px 0;
  font-size: 12px;
}

/* ── Canvas Area ── */
.be-canvas-area {
  flex: 1;
  overflow: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #111118;
  min-width: 0;
  padding: 20px;
}
.be-canvas-container {
  position: relative;
  flex-shrink: 0;
  box-shadow: 0 4px 24px rgba(0,0,0,.5);
  background: repeating-conic-gradient(#2a2a3a 0% 25%, #222230 0% 50%) 0 0/16px 16px;
}
.be-canvas-container canvas {
  display: block;
}

/* ── Selection box ── */
.be-selection-box {
  position: absolute;
  border: 2px dashed rgba(74,144,217,.8);
  pointer-events: none;
  z-index: 10;
}
.be-handle {
  position: absolute;
  width: 10px;
  height: 10px;
  background: #4a90d9;
  border: 1px solid #fff;
  border-radius: 2px;
  pointer-events: all;
  cursor: nwse-resize;
  z-index: 11;
}
.be-handle-tl { top: -5px; left: -5px; cursor: nwse-resize; }
.be-handle-tr { top: -5px; right: -5px; cursor: nesw-resize; }
.be-handle-bl { bottom: -5px; left: -5px; cursor: nesw-resize; }
.be-handle-br { bottom: -5px; right: -5px; cursor: nwse-resize; }
.be-handle-rotate {
  position: absolute;
  top: -28px;
  left: 50%;
  transform: translateX(-50%);
  width: 20px;
  height: 20px;
  background: #6366f1;
  border: 1px solid #fff;
  border-radius: 50%;
  cursor: grab;
  font-size: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  color: #fff;
  pointer-events: all;
}
.be-handle-rotate:active { cursor: grabbing; }

/* ── Properties Panel ── */
.be-props-panel {
  width: 220px;
  background: #181825;
  border-left: 1px solid rgba(255,255,255,.08);
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  overflow-y: auto;
}
.be-props-body {
  flex: 1;
  overflow-y: auto;
  padding: 4px;
}
.be-prop-section {
  padding: 8px;
  border-bottom: 1px solid rgba(255,255,255,.06);
}
.be-prop-title {
  font-size: 11px;
  font-weight: 600;
  color: #6aabf7;
  text-transform: uppercase;
  letter-spacing: .04em;
  margin-bottom: 8px;
}
.be-prop-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 6px;
}
.be-prop-row label {
  font-size: 11px;
  color: #888;
  min-width: 48px;
  flex-shrink: 0;
}
.be-prop-row .be-input,
.be-prop-row .be-select {
  flex: 1;
  min-width: 0;
}
.be-prop-unit {
  font-size: 10px;
  color: #5a5e72;
  white-space: nowrap;
}

/* ── Font button ── */
.be-font-btn {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 5px;
  padding: 4px 8px;
  color: #c5cde8;
  cursor: pointer;
  font-size: 12px;
  text-align: left;
  min-width: 0;
}
.be-font-btn:hover { background: rgba(255,255,255,.1); border-color: rgba(74,144,217,.4); }
.be-font-btn span:first-child {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.be-font-btn-icon { flex-shrink: 0; }

/* ── Style buttons ── */
.be-btn-group {
  display: flex;
  gap: 2px;
}
.be-style-btn {
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.1);
  color: #aaa;
  width: 26px;
  height: 24px;
  border-radius: 4px;
  cursor: pointer;
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .12s;
}
.be-style-btn:hover { background: rgba(255,255,255,.12); color: #fff; }
.be-style-btn.active { background: rgba(74,144,217,.3); border-color: #4a90d9; color: #fff; }

/* ── Zoom ── */
.be-zoom-range {
  width: 80px;
  accent-color: #6366f1;
  cursor: pointer;
}
.be-zoom-label {
  font-size: 11px;
  color: #6aabf7;
  min-width: 36px;
  text-align: center;
  cursor: pointer;
  padding: 2px 4px;
  border-radius: 4px;
  white-space: nowrap;
}
.be-zoom-label:hover { background: rgba(255,255,255,.08); }

/* ── Status bar ── */
.be-statusbar {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 4px 12px;
  background: #181825;
  border-top: 1px solid rgba(255,255,255,.08);
  font-size: 11px;
  color: #5a5e72;
  flex-shrink: 0;
}

/* ── Scrollbars ── */
.be-layers-list::-webkit-scrollbar,
.be-props-body::-webkit-scrollbar,
.be-canvas-area::-webkit-scrollbar {
  width: 5px;
  height: 5px;
}
.be-layers-list::-webkit-scrollbar-track,
.be-props-body::-webkit-scrollbar-track,
.be-canvas-area::-webkit-scrollbar-track {
  background: transparent;
}
.be-layers-list::-webkit-scrollbar-thumb,
.be-props-body::-webkit-scrollbar-thumb,
.be-canvas-area::-webkit-scrollbar-thumb {
  background: rgba(74,144,217,.2);
  border-radius: 4px;
}
